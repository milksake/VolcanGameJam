text = "[center][b]LEGACY GANG[/b][/center]

[center]— EQUIPO —[/center]

[b]José[/b] — Música, programación
[b]Giovanni[/b] — Programación, diseño 3D
[b]Alex[/b] — Diseño 3D
[b]Mariana[/b] — Programación (Godot)
[b]Ninoska[/b] — Arte 2D

[center]— MÚSICA —[/center]
Música original compuesta por José y Giovanni.
Masterización y mezcla final: José.

[center]— ARTE Y MODELOS 3D —[/center]
Diseños originales por Alex.
Modelos adicionales: Poly Pizza (poly.pizza).

[center]— ARTE 2D —[/center]
Ilustraciones por Ninoska.

[center]Hecho con Godot Engine · 2026[/center]"
fit_content = true

